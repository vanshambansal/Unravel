# Copy this file to apps/web/.env.local. Use your own development services.
# Never commit .env.local. Browser-visible settings use NEXT_PUBLIC_; all others stay server-side.

# REQUIRED for developer sign-in and the complete application: your Clerk development app.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/app/projects
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/app/projects

# REQUIRED for projects/reports: your PostgreSQL application database connection URI.
DATABASE_URL=
# REQUIRED for db:migrate: direct connection to the SAME database (not a different branch).
DATABASE_MIGRATION_URL=

# Optional private-API/browser tests: a SEPARATE disposable database and two synthetic Clerk users.
# TEST_DATABASE_URL must not identify the application database. Never use a production database.
TEST_DATABASE_URL=
E2E_CLERK_USER_EMAIL=
E2E_CLERK_OTHER_EMAIL=

# Local dev defaults: http://localhost:3000 and isolated player http://127.0.0.1:4192.
# Root pnpm dev pairs these automatically. Set these explicitly for a different production host.
APP_ORIGIN=
REPLAY_ORIGIN=
# Optional diagnostics, normally off. These are not needed to run the application.
NEXT_PUBLIC_MOTION_DIAGNOSTICS=0

# Optional signed Clerk user.deleted webhook. Not needed for local basic workflows.
# Required and separately verified before public account-closure intake blocking.
CLERK_WEBHOOK_SIGNING_SECRET=

# External preview intake requires explicit opt-in and valid HTTPS APP_ORIGIN/REPLAY_ORIGIN.
# Keep disabled during local setup. Existing validation, quotas and storage caps still apply.
PUBLIC_INGESTION_ENABLED=false
# Owner-authenticated, same-origin portfolio demo; does not enable public SDK intake.
PORTFOLIO_DEMO_ENABLED=false
EDGE_INGESTION_PROTECTED=false
# The remaining declarations belong to the broader production checklist, not the intake switch.
PUBLIC_PRIVACY_REVIEWED=false
REPORT_RETENTION_POLICY=
# Set true ONLY for local production-mode recording tests; leave public safeguards unchanged.
ALLOW_LOOPBACK_INGESTION=false
