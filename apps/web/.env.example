# Copy to apps/web/.env.local and enter development credentials there.
# Never commit .env.local or paste secret values into chat.
# Use the existing user-owned Unravel Clerk development application.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/app/projects
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/app/projects

# Neon development database; server only. Leave blank until database setup.
DATABASE_URL=
# Direct connection for reviewed migrations, to the same development database.
DATABASE_MIGRATION_URL=
# Separate disposable test database/branch. Never use development/production here.
TEST_DATABASE_URL=

# Optional real-session browser proof: two EXISTING synthetic Clerk development users.
# These are test identities, not passwords. The test creates synthetic project rows.
E2E_CLERK_USER_EMAIL=
E2E_CLERK_OTHER_EMAIL=

# Release gates; leave public ingestion disabled until docs/DEPLOYMENT.md is verified.
APP_ORIGIN=
REPLAY_ORIGIN=
PUBLIC_INGESTION_ENABLED=false
# Local production previews only; dev loopback ingestion needs no opt-in.
ALLOW_LOOPBACK_INGESTION=false
EDGE_INGESTION_PROTECTED=false
PUBLIC_PRIVACY_REVIEWED=false
REPORT_RETENTION_POLICY=

# Signed user.deleted delivery; optional locally, required for public account-closure intake blocking.
CLERK_WEBHOOK_SIGNING_SECRET=
