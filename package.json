{
  "name": "unravel",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22.18.0 <23"
  },
  "scripts": {
    "dev": "corepack pnpm --filter @unravel/web dev",
    "start": "corepack pnpm --filter @unravel/web start",
    "lint": "eslint apps/web/src tests playwright.config.ts",
    "typecheck": "corepack pnpm --filter @unravel/web typecheck && tsc -p tests/tsconfig.json",
    "test": "node --experimental-strip-types --test tests/unit/*.test.ts",
    "build": "corepack pnpm posters:check && corepack pnpm --filter @unravel/web build",
    "test:e2e": "playwright test",
    "posters:check": "node scripts/check-posters.mjs",
    "posters:capture": "node scripts/capture-posters.mjs",
    "posters:stamp": "node scripts/check-posters.mjs --stamp",
    "reference:check": "node scripts/check-reference.mjs",
    "browsers:install": "node scripts/install-browser.mjs",
    "parity:reference": "node scripts/compare-reference.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/node": "22.18.0",
    "eslint": "10.14.0",
    "typescript": "5.9.3",
    "@eslint/js": "10.0.1",
    "typescript-eslint": "8.72.2",
    "@next/eslint-plugin-next": "16.4.6",
    "eslint-plugin-react-hooks": "7.1.1"
  },
  "type": "module"
}
