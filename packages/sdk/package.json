{
  "name": "@vansham/unravel-sdk",
  "version": "0.1.1",
  "description": "Explicit browser bug recording, diagnostics and reporting widget for Unravel",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vanshambansal/Unravel.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://github.com/vanshambansal/Unravel/tree/main/packages/sdk#readme",
  "bugs": {
    "url": "https://github.com/vanshambansal/Unravel/issues"
  },
  "keywords": [
    "bug-reporting",
    "session-replay",
    "react",
    "nextjs",
    "rrweb"
  ],
  "publishConfig": {
    "access": "public"
  },
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "dist/**/*.LEGAL.txt",
    "LICENSE",
    "THIRD_PARTY_NOTICES.txt"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@unravel/contracts": "workspace:*",
    "@rrweb/record": "2.2.2",
    "@rrweb/types": "2.2.2",
    "esbuild": "0.28.2"
  }
}
