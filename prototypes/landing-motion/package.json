{
  "name": "unravel-landing-motion",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4174 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "posters:check": "node scripts/check-posters.mjs",
    "posters:stamp": "node scripts/check-posters.mjs --stamp",
    "build": "tsc --noEmit && npm run posters:check && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4174 --strictPort"
  },
  "dependencies": { "gsap": "3.15.1", "three": "0.187.0" },
  "devDependencies": { "@types/three": "0.183.1", "typescript": "5.9.3", "vite": "8.3.7" }
}
