# OPTIONAL standalone replay-host configuration. Root pnpm dev needs none of these.
# Copy to scripts/.env.local, build with pnpm build:replay, then explicitly load it:
# node --env-file=scripts/.env.local scripts/replay-host.mjs
# This host must receive NO Clerk/database credentials.
REPLAY_PORT=4192
REPLAY_LISTEN_HOST=127.0.0.1
REPLAY_PUBLIC_ORIGIN=http://127.0.0.1:4192
REPLAY_PARENT_ORIGINS=http://localhost:3000
# Optional local HTTPS files; blank means HTTP on loopback only.
REPLAY_TLS_CERT_FILE=
REPLAY_TLS_KEY_FILE=
